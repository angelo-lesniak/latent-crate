#!/usr/bin/env bash
set -Eeuo pipefail

# The wrapper relies on bash 4.3+ features (exec {FD}>, name references,
# ${var,,}). macOS ships bash 3.2, which fails in confusing ways.
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3))); then
  printf 'LatentCrate: bash %s is too old; bash 4.3 or newer is required. Run LatentCrate inside WSL2 or native Linux.\n' \
    "$BASH_VERSION" >&2
  exit 1
fi

PROJECT_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
readonly PROJECT_ROOT

# Load only fixed, repository-relative implementation modules.
# shellcheck source=lib/latentcrate/core.sh
source "$PROJECT_ROOT/lib/latentcrate/core.sh"
# shellcheck source=lib/latentcrate/frontend.sh
source "$PROJECT_ROOT/lib/latentcrate/frontend.sh"
# shellcheck source=lib/latentcrate/node-deps.sh
source "$PROJECT_ROOT/lib/latentcrate/node-deps.sh"
# shellcheck source=lib/latentcrate/nodes.sh
source "$PROJECT_ROOT/lib/latentcrate/nodes.sh"
# shellcheck source=lib/latentcrate/models.sh
source "$PROJECT_ROOT/lib/latentcrate/models.sh"
# shellcheck source=lib/latentcrate/templates.sh
source "$PROJECT_ROOT/lib/latentcrate/templates.sh"
# shellcheck source=lib/latentcrate/runtime.sh
source "$PROJECT_ROOT/lib/latentcrate/runtime.sh"

usage() {
  cat <<'EOF'
LatentCrate - pinned ComfyUI containers for Docker and Podman

Usage:
  bin/latentcrate init [--node-set name]
      Create .env and the host data directories; optionally install a node set.
  bin/latentcrate doctor [--allow-no-gpu] [--sage mode]
      Check the host (engine, GPU, directories, ports) before building.
  bin/latentcrate up [--sage mode] [--detach] [--model-set name] [frontend flag]
      Build the image if needed and start ComfyUI.
  bin/latentcrate build [--sage mode] [frontend flag]
      Build the image without starting ComfyUI.
  bin/latentcrate down
      Stop and remove the ComfyUI container.
  bin/latentcrate config [--sage mode] [frontend flag]
      Print the resolved Compose configuration.
  bin/latentcrate status
      Show the ComfyUI container status.
  bin/latentcrate wait [--timeout seconds]
      Block until the running container reports healthy.
  bin/latentcrate logs
      Follow the ComfyUI container logs.
  bin/latentcrate shell
      Open a bash shell in the running container.
  bin/latentcrate smoke-gpu [--sage mode] [frontend flag]
      Run the GPU verification suite in the running container and save a report.
  bin/latentcrate node-deps snapshot
      Capture custom-node Python dependencies for the next image build.
  bin/latentcrate node-deps clear
      Reset the saved custom-node dependency snapshot.
  bin/latentcrate nodes list
      List the available custom-node sets with their descriptions.
  bin/latentcrate nodes install <set>
      Install a pinned custom-node set (stop ComfyUI first).
  bin/latentcrate nodes sync <set>
      Install the set, replacing clean checkouts pinned at other commits.
  bin/latentcrate nodes status <set>
      Report how the managed third-party nodes compare to the set.
  bin/latentcrate models list
      List the available pinned model-file sets.
  bin/latentcrate models fetch <set> [<set> ...] | all
      Download and verify one or more model sets from Hugging Face.
  bin/latentcrate models status <set> [<set> ...] | all
      Verify the selected files already present in the models directory.
  bin/latentcrate templates list
      List official templates marked for local ComfyUI use in the built image.
  bin/latentcrate templates create-model-set <template> [--name name]
      Create a reviewable model-set manifest draft from a template.
  bin/latentcrate pins
      Print the pinned components from pins.env.

Frontend flags (the default builds the pinned frontend tag from Git):
  --frontend-git <https-url> <commit-branch-tag-or-pr-reference>
  --frontend-source <absolute-or-relative-source-directory>  (up/config/smoke-gpu)
  --frontend-dist <absolute-or-relative-dist-directory>  (up/config/smoke-gpu)

Settings come from .env.example, overridden by .env. Set
CONTAINER_ENGINE=docker or CONTAINER_ENGINE=podman to override detection.
Sage modes (LATENTCRATE_SAGE in .env, or --sage for one command):
  off        smaller image without SageAttention (the default)
  available  Sage-capable image; workflows opt in
  global     Sage-capable image; ComfyUI applies Sage globally
EOF
}

set_default_sage_variant() {
  local value=${LATENTCRATE_SAGE:-off}
  case "${value,,}" in
    off|available|global) SAGE_MODE=${value,,} ;;
    *) die 'LATENTCRATE_SAGE must be off, available, or global' ;;
  esac
}

set_sage_mode_flag() {
  case "${1,,}" in
    off|available|global) SAGE_MODE=${1,,} ;;
    *) die '--sage requires a mode: off, available, or global' ;;
  esac
}

parse_variant_options() {
  local command=$1
  shift
  local frontend_seen=false

  set_default_sage_variant
  DETACH=false
  MODEL_SETS=()

  while (($# > 0)); do
    case "$1" in
      --sage)
        (($# >= 2)) || die '--sage requires a mode: off, available, or global'
        set_sage_mode_flag "$2"
        shift
        ;;
      --detach|-d)
        [[ "$command" == up ]] || die "$1 is only valid with up"
        DETACH=true
        ;;
      --model-set)
        [[ "$command" == up ]] || die '--model-set is only valid with up'
        (($# >= 2)) || die '--model-set requires a set name'
        [[ "$2" != all ]] || die 'use individual --model-set names with up; all is available through models fetch'
        model_set_file "$2" >/dev/null
        MODEL_SETS+=("$2")
        shift
        ;;
      --frontend-git)
        [[ "$frontend_seen" == false ]] || die 'only one frontend flag may be supplied'
        (($# >= 3)) \
          || die '--frontend-git requires a repository URL and a commit, branch, tag, or pull-request reference'
        frontend_seen=true
        export COMFY_FRONTEND_MODE=git
        export FRONTEND_GIT_URL=$2
        export FRONTEND_GIT_REF=$3
        unset FRONTEND_GIT_REQUESTED_REF || true
        shift 2
        ;;
      --frontend-source)
        [[ "$command" == up || "$command" == config || "$command" == smoke-gpu ]] \
          || die '--frontend-source is only valid with up, config, or smoke-gpu'
        [[ "$frontend_seen" == false ]] || die 'only one frontend flag may be supplied'
        (($# >= 2)) || die '--frontend-source requires a directory'
        frontend_seen=true
        export COMFY_FRONTEND_MODE=source
        export COMFY_FRONTEND_SOURCE_DIR=$2
        shift
        ;;
      --frontend-dist)
        [[ "$command" == up || "$command" == config || "$command" == smoke-gpu ]] \
          || die '--frontend-dist is only valid with up, config, or smoke-gpu'
        [[ "$frontend_seen" == false ]] || die 'only one frontend flag may be supplied'
        (($# >= 2)) || die '--frontend-dist requires a directory'
        frontend_seen=true
        export COMFY_FRONTEND_MODE=dist
        export COMFY_FRONTEND_DIST_DIR=$2
        shift
        ;;
      --*) die "unknown option for $command: $1" ;;
      *) die "unknown argument for $command: $1" ;;
    esac
    shift
  done
}

# down, status, and logs render the project without resolving the frontend
# reference or asking for the GPU, so they work offline and with broken pins.
configure_render_only() {
  (($# == 0)) || die "unknown argument: $1"
  set_default_sage_variant
  RESOLVE_FRONTEND_REF=false
  configure_variant "$SAGE_MODE"
}

main() {
  local command=${1:-help}
  local engine timeout allow_no_gpu node_set model_action template_action template_name draft_name sage_enabled
  local -a up_args
  local -a model_sets
  shift || true

  cd "$PROJECT_ROOT"
  INCLUDE_FRONTEND_OVERLAY=false
  INCLUDE_GPU_OVERLAY=false
  FRONTEND_SOURCE_BUILD=false

  case "$command" in
    help|-h|--help)
      (($# == 0)) || die 'help accepts no arguments'
      usage
      return
      ;;
    pins)
      (($# == 0)) || die 'pins accepts no arguments'
      load_pins
      print_pins
      return
      ;;
  esac

  # Every remaining command needs a Linux userland (flock, Compose bind
  # mounts, CDI devices). LATENTCRATE_SKIP_PLATFORM_CHECK=1 is an escape
  # hatch for the engine-free test suites on macOS or Windows dev machines.
  if ! is_true "${LATENTCRATE_SKIP_PLATFORM_CHECK:-false}"; then
    [[ "$(uname -s 2>/dev/null)" == Linux ]] \
      || die 'LatentCrate must run inside WSL2 or native Linux. Git Bash and PowerShell are not supported.'
  fi

  load_local_env
  load_pins
  capture_hf_token

  case "$command" in
    init)
      node_set=
      while (($# > 0)); do
        case "$1" in
          --node-set)
            (($# >= 2)) || die '--node-set requires a set name'
            [[ -z "$node_set" ]] || die 'init accepts at most one --node-set option'
            node_set=$2
            node_set_file "$node_set" >/dev/null
            shift
            ;;
          --*) die "unknown init option: $1" ;;
          *) die "unknown init argument: $1" ;;
        esac
        shift
      done
      init_project
      load_pins
      capture_hf_token
      [[ -z "$node_set" ]] || run_node_set install "$node_set"
      ;;
    doctor)
      allow_no_gpu=false
      set_default_sage_variant
      while (($# > 0)); do
        case "$1" in
          --allow-no-gpu) allow_no_gpu=true ;;
          --sage)
            (($# >= 2)) || die '--sage requires a mode: off, available, or global'
            set_sage_mode_flag "$2"
            shift
            ;;
          --*) die "unknown doctor option: $1" ;;
          *) die "unknown doctor argument: $1" ;;
        esac
        shift
      done
      sage_enabled=true
      [[ "$SAGE_MODE" != off ]] || sage_enabled=false
      bash "$PROJECT_ROOT/scripts/doctor.sh" \
        --engine "${CONTAINER_ENGINE:-}" \
        --allow-no-gpu "$allow_no_gpu" \
        --min-driver-major "$CUDA_MIN_DRIVER_MAJOR" \
        --cuda-arch-list "$COMFY_CUDA_ARCH_LIST" \
        --sage "$sage_enabled"
      ;;
    up)
      parse_variant_options up "$@"
      INCLUDE_GPU_OVERLAY=true
      configure_variant "$SAGE_MODE"
      validate_bind_address
      prepare_host_directories
      engine=$(detect_engine)
      if ((${#MODEL_SETS[@]} > 0)); then
        run_model_sets fetch "${MODEL_SETS[@]}"
      fi
      if [[ "$FRONTEND_SOURCE_BUILD" == true ]]; then
        build_local_frontend "$engine"
      fi
      [[ "${COMFY_FRONTEND_MODE}" == dist ]] && INCLUDE_FRONTEND_OVERLAY=true
      run_refreshed_build "$engine" \
        'custom-node dependency build failed; restored the last buildable snapshot'
      # Every up builds an image first. Recreate unconditionally so Compose
      # cannot keep a container that still points at the previous image ID.
      up_args=(up --no-build --force-recreate)
      if [[ "$DETACH" == true ]]; then
        compose "$engine" "${up_args[@]}" --detach comfy
        printf 'Run: bash bin/latentcrate wait\n'
      else
        compose "$engine" "${up_args[@]}" comfy
      fi
      ;;
    build)
      parse_variant_options build "$@"
      INCLUDE_GPU_OVERLAY=true
      configure_variant "$SAGE_MODE"
      [[ "$COMFY_FRONTEND_MODE" != dist ]] \
        || die 'build supports the pinned and Git frontends; use up for --frontend-source or --frontend-dist'
      engine=$(detect_engine)
      run_refreshed_build "$engine" 'image build failed'
      ;;
    down)
      configure_render_only "$@"
      INCLUDE_GPU_OVERLAY=true
      engine=$(detect_engine)
      compose "$engine" down
      ;;
    config)
      parse_variant_options config "$@"
      configure_variant "$SAGE_MODE"
      [[ "${COMFY_FRONTEND_MODE}" == dist ]] && INCLUDE_FRONTEND_OVERLAY=true
      engine=$(detect_engine)
      compose "$engine" config
      ;;
    status)
      configure_render_only "$@"
      INCLUDE_GPU_OVERLAY=true
      engine=$(detect_engine)
      compose "$engine" ps
      ;;
    wait)
      timeout=180
      while (($# > 0)); do
        case "$1" in
          --timeout)
            (($# >= 2)) || die '--timeout requires seconds'
            timeout=$2
            [[ "$timeout" =~ ^[1-9][0-9]*$ ]] || die '--timeout must be a positive integer'
            shift
            ;;
          --*) die "unknown wait option: $1" ;;
          *) die "unknown wait argument: $1" ;;
        esac
        shift
      done
      engine=$(detect_engine)
      wait_until_healthy "$engine" "$timeout"
      ;;
    logs)
      configure_render_only "$@"
      INCLUDE_GPU_OVERLAY=true
      engine=$(detect_engine)
      compose "$engine" logs --follow comfy
      ;;
    shell)
      configure_render_only "$@"
      INCLUDE_GPU_OVERLAY=true
      engine=$(detect_engine)
      compose "$engine" exec comfy bash
      ;;
    smoke-gpu)
      parse_variant_options smoke-gpu "$@"
      INCLUDE_GPU_OVERLAY=true
      configure_variant "$SAGE_MODE"
      [[ "${COMFY_FRONTEND_MODE}" == dist ]] && INCLUDE_FRONTEND_OVERLAY=true
      engine=$(detect_engine)
      run_gpu_smoke "$engine" "$SAGE"
      ;;
    node-deps)
      case "${1:-}" in
        snapshot)
          (($# == 1)) || die 'node-deps snapshot accepts no additional arguments'
          acquire_node_dependency_lock
          trap 'release_node_dependency_lock' EXIT
          snapshot_node_dependencies
          release_node_dependency_lock
          trap - EXIT
          ;;
        clear)
          (($# == 1)) || die 'node-deps clear accepts no additional arguments'
          acquire_node_dependency_lock
          trap 'release_node_dependency_lock' EXIT
          clear_node_dependencies
          release_node_dependency_lock
          trap - EXIT
          ;;
        *) die 'usage: bin/latentcrate node-deps snapshot | node-deps clear' ;;
      esac
      ;;
    nodes)
      case "${1:-}" in
        list)
          (($# == 1)) || die 'nodes list accepts no additional arguments'
          list_node_sets
          ;;
        install|sync|status)
          (($# == 2)) || die "nodes ${1:-install} requires exactly one set name"
          run_node_set "$1" "$2"
          ;;
        *) die 'usage: bin/latentcrate nodes list | nodes install <set> | nodes sync <set> | nodes status <set>' ;;
      esac
      ;;
    models)
      model_action=${1:-}
      case "$model_action" in
        list)
          (($# == 1)) || die 'models list accepts no additional arguments'
          list_model_sets
          ;;
        fetch|status)
          shift
          model_sets=()
          while (($# > 0)); do
            case "$1" in
              --*) die "unknown models $model_action option: $1" ;;
              *) model_sets+=("$1") ;;
            esac
            shift
          done
          run_model_sets "$model_action" "${model_sets[@]}"
          ;;
        *) die 'usage: bin/latentcrate models list | models fetch <set> [<set> ...] | all | models status <set> [<set> ...] | all' ;;
      esac
      ;;
    templates)
      template_action=${1:-}
      case "$template_action" in
        list)
          (($# == 1)) || die 'templates list accepts no additional arguments'
          run_template_tool list
          ;;
        create-model-set)
          (($# >= 2)) || die 'templates create-model-set requires a template ID'
          template_name=$2
          draft_name=$template_name
          shift 2
          while (($# > 0)); do
            case "$1" in
              --name)
                (($# >= 2)) || die '--name requires a model-set name'
                draft_name=$2
                shift
                ;;
              --*) die "unknown templates create-model-set option: $1" ;;
              *) die "unknown templates create-model-set argument: $1" ;;
            esac
            shift
          done
          validate_template_name "$template_name"
          validate_draft_name "$draft_name"
          run_template_tool create-model-set "$template_name" "$draft_name"
          ;;
        *) die 'usage: bin/latentcrate templates list | templates create-model-set <template> [--name name]' ;;
      esac
      ;;
    *)
      printf 'LatentCrate: unknown command: %s\n' "$command" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
