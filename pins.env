# Pinned components. Compose reads this file through --env-file and passes
# every value except CUDA_MIN_DRIVER_MAJOR (checked by doctor) as a build
# argument; the image names live in compose.yaml and the Dockerfile.
# Experiments with other pins are a branch. Each base image is pinned by its
# tag and by its sha256 manifest digest, because a tag can be moved; the
# digest is what the build pulls. Each tag-fetched source is pinned by its
# tag and by the commit the tag names, for the same reason: the build checks
# out the tag and refuses another commit. The two PyTorch tags move together.
PYTORCH_DEVEL_TAG=2.14.1-cuda13.0-cudnn9-devel
PYTORCH_DEVEL_DIGEST=4e76657a91117d4373f0a4ba514fb55cbac4c846539aae8f36ed6800254c9a46
PYTORCH_RUNTIME_TAG=2.14.1-cuda13.0-cudnn9-runtime
PYTORCH_RUNTIME_DIGEST=3c0b174a1339193a5bcc4b37d737c9f5ca3c4782a2293d3888e4271367eddf44
# TorchCodec's +cuNNN suffix and the NPP major follow the PyTorch tag's CUDA family.
TORCHCODEC_VERSION=0.17.0+cu130
CUDA_NPP_VERSION=13.0.1.2
COMFYUI_REF=v0.45.0
COMFYUI_COMMIT=989d93d0d968e704c589ce0146bb18c77f6b50cc
COMFYUI_FRONTEND_REF=v1.58.5
COMFYUI_FRONTEND_COMMIT=f7bcaf00095ddead1be4480b01f7cd6e851f726d
FFMPEG_REF=n9.0.2
FFMPEG_COMMIT=946fcce07b6dcd0331c8cc609192aeff5e1924f8
NV_CODEC_HEADERS_REF=n13.1.15.0
NV_CODEC_HEADERS_COMMIT=0a6fba9a2820628b8103464f4c8753ee05838baa
SVT_AV1_REF=v4.3.0
SVT_AV1_COMMIT=e3d63405f9ba8219913a7276c2c47d10e5d022fe
SAGEATTENTION_REF=v2.2.0
SAGEATTENTION_COMMIT=eb615cf6cf4d221338033340ee2de1c37fbdba4a
FRONTEND_NODE_TAG=26-bookworm-slim
FRONTEND_NODE_DIGEST=5df79989ed685e09f0a98019db4cebfb22fb9df1a53c0161664a011f7ff6b0f1
FRONTEND_PNPM_VERSION=12.18.0
CUDA_MIN_DRIVER_MAJOR=580
