# Pinned components. Compose reads this file through --env-file and passes
# every value except CUDA_MIN_DRIVER_MAJOR (checked by doctor) as a build
# argument; the image names live in compose.yaml and the Dockerfiles.
# Experiments with other pins are a branch. Each base image is pinned by its
# tag and by its sha256 manifest digest, because a tag can be moved; the
# digest is what the build pulls. The two PyTorch tags move together.
PYTORCH_DEVEL_TAG=2.13.0-cuda13.0-cudnn9-devel
PYTORCH_DEVEL_DIGEST=c74b2049d204a55233abace509fdb1f6bdbe2d169bee382ed2f06cac00ba76c4
PYTORCH_RUNTIME_TAG=2.13.0-cuda13.0-cudnn9-runtime
PYTORCH_RUNTIME_DIGEST=db80a41f8428644cebcb3d75b0b62df334ab6c0e75785951eb25f48bfbd42407
# TorchCodec's +cuNNN suffix and the NPP major follow the PyTorch tag's CUDA family.
TORCHCODEC_VERSION=0.16.0+cu130
CUDA_NPP_VERSION=13.0.1.2
COMFYUI_REF=v0.34.0
COMFYUI_FRONTEND_REF=v1.53.1
FFMPEG_REF=n9.0.1
NV_CODEC_HEADERS_REF=n13.1.15.0
SVT_AV1_REF=v4.2.0
SAGEATTENTION_REF=v2.2.0
FRONTEND_NODE_TAG=26-bookworm-slim
FRONTEND_NODE_DIGEST=88e480776c6149ff1d098cd304f44bf18057fb5d284a3329b78162d29821e28c
FRONTEND_PNPM_VERSION=11.24.0
CUDA_MIN_DRIVER_MAJOR=580
