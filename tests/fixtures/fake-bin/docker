#!/usr/bin/env bash
set -Eeuo pipefail

[[ ! -v HF_TOKEN && ! -v LATENTCRATE_HF_TOKEN_VALUE ]] \
  || { printf 'fake docker: Hugging Face token leaked into the engine environment\n' >&2; exit 1; }

case "${1:-}" in
  info)
    printf 'fake Docker engine\n'
    ;;
  compose)
    shift
    if [[ "${1:-}" == version ]]; then
      printf 'Docker Compose version fake\n'
    else
      [[ " $* " != *' ps comfy '* ]] \
        || { printf 'fake Compose provider: ps does not accept a service argument\n' >&2; exit 1; }
      for tool_service in node-set node-set-status model-set model-set-status template-inspector template-draft node-deps-snapshot frontend-release-pin version-update frontend-fetch frontend-build; do
        if [[ " $* " == *" build $tool_service "* \
            || " $* " == *" run "*" $tool_service "* ]]; then
          [[ " $* " == *' --profile tools '* ]] \
            || { printf 'fake Compose provider: missing tools profile for %s\n' "$tool_service" >&2; exit 1; }
        fi
      done
      trace_fd=1
      [[ "${FAKE_DOCKER_TRACE_STDERR:-false}" != true ]] || trace_fd=2
      {
        printf 'target=%s mode=%s sage=%s args=' \
          "${COMFY_BUILD_TARGET:-unset}" "${COMFY_FRONTEND_MODE:-unset}" \
          "${LATENTCRATE_SAGE_MODE:-unset}"
        printf ' %q' "$@"
        printf '\n'
      } >&"$trace_fd"
      if [[ " $* " == *" run "*" frontend-release-pin digest "* ]]; then
        if [[ -n "${FAKE_FRONTEND_PROFILE_TO_CHANGE:-}" ]]; then
          printf 'CHANGED_DURING_DOWNLOAD=true\n' >> "$FAKE_FRONTEND_PROFILE_TO_CHANGE"
        fi
        printf '%064d\n' 0
        printf 'COMFY_FRONTEND_DIST_SHA256=%s\n' \
          "${FAKE_FRONTEND_RELEASE_DIGEST:-invalid-digest}"
        exit 0
      fi
      if [[ " $* " == *" run "*" version-update resolve "* ]]; then
        if [[ -n "${FAKE_VERSION_PROFILE_TO_CHANGE:-}" ]]; then
          printf 'CHANGED_DURING_RESOLUTION=true\n' >> "$FAKE_VERSION_PROFILE_TO_CHANGE"
        fi
        printf '%064d\n' 0
        printf '%b\n' "${FAKE_VERSION_UPDATE_OUTPUT:-LATENTCRATE_VERSION_RESULT|all|0}"
        exit 0
      fi
    fi
    ;;
  ps)
    [[ " $* " == *' --quiet '* ]] \
      || { printf 'fake docker: ps requires --quiet\n' >&2; exit 1; }
    [[ " $* " == *' --filter label=com.docker.compose.project=latentcrate '* ]] \
      || { printf 'fake docker: missing Compose project filter\n' >&2; exit 1; }
    [[ " $* " == *' --filter label=com.docker.compose.service=comfy '* ]] \
      || { printf 'fake docker: missing Compose service filter\n' >&2; exit 1; }
    if [[ "${FAKE_DOCKER_COMFY_RUNNING:-false}" == true ]]; then
      printf 'fake-comfy-container\n'
    fi
    ;;
  *)
    printf 'fake docker: unsupported invocation: %s\n' "$*" >&2
    exit 1
    ;;
esac
