#!/usr/bin/env bash
set -Eeuo pipefail

[[ ! -v HF_TOKEN && ! -v LATENTCRATE_HF_TOKEN_VALUE ]] \
  || { printf 'fake docker: Hugging Face token leaked into the engine environment\n' >&2; exit 1; }

case "${1:-}" in
  info)
    printf 'fake Docker engine\n'
    ;;
  compose)
    shift
    if [[ "${1:-}" == version ]]; then
      printf 'Docker Compose version fake\n'
    else
      [[ " $* " != *' ps comfy '* ]] \
        || { printf 'fake Compose provider: ps does not accept a service argument\n' >&2; exit 1; }
      for tool_service in node-set node-set-status model-set model-set-status template-inspector template-draft node-deps-snapshot frontend-fetch frontend-build; do
        if [[ " $* " == *" build $tool_service "* \
            || " $* " == *" run "*" $tool_service "* ]]; then
          [[ " $* " == *' --profile tools '* ]] \
            || { printf 'fake Compose provider: missing tools profile for %s\n' "$tool_service" >&2; exit 1; }
        fi
      done
      trace_fd=1
      [[ "${FAKE_DOCKER_TRACE_STDERR:-false}" != true ]] || trace_fd=2
      {
        printf 'target=%s mode=%s sage=%s image=%s args=' \
          "${COMFY_BUILD_TARGET:-unset}" "${COMFY_FRONTEND_MODE:-unset}" \
          "${LATENTCRATE_SAGE:-unset}" "${LATENTCRATE_IMAGE:-unset}"
        printf ' %q' "$@"
        printf '\nFRONTEND_GIT_URL=%s FRONTEND_GIT_REF=%s FRONTEND_GIT_REQUESTED_REF=%s\n' \
          "${FRONTEND_GIT_URL-unset}" "${FRONTEND_GIT_REF-unset}" "${FRONTEND_GIT_REQUESTED_REF-unset}"
      } >&"$trace_fd"
    fi
    ;;
  image|inspect)
    [[ "${FAKE_DOCKER_COMFY_RUNNING:-false}" == true ]] \
      || { printf 'fake docker: no image or container to inspect\n' >&2; exit 1; }
    printf 'sha256:fake-image-id\n'
    ;;
  ps)
    [[ " $* " == *' --quiet '* ]] \
      || { printf 'fake docker: ps requires --quiet\n' >&2; exit 1; }
    [[ " $* " == *' --filter label=com.docker.compose.project=latentcrate '* ]] \
      || { printf 'fake docker: missing Compose project filter\n' >&2; exit 1; }
    [[ " $* " == *' --filter label=com.docker.compose.service=comfy '* ]] \
      || { printf 'fake docker: missing Compose service filter\n' >&2; exit 1; }
    if [[ "${FAKE_DOCKER_COMFY_RUNNING:-false}" == true ]]; then
      printf 'fake-comfy-container\n'
    fi
    ;;
  *)
    printf 'fake docker: unsupported invocation: %s\n' "$*" >&2
    exit 1
    ;;
esac
