# Local machine settings; the reference for every setting.
# docs/configuration.md says when a change takes effect.
#
# Run `bash bin/latentcrate init` to create a private .env from this file with
# mode 0600; copying it by hand may leave its permissions too broad.
# Write full paths and keep comments on their own lines.

# Host paths. Relative paths are resolved from the repository root.
COMFY_DATA_DIR=./data/comfy
COMFY_MODELS_DIR=./data/models
COMFY_CACHE_DIR=./data/cache
# Local-only node source is mounted read-only.
COMFY_LOCAL_NODES_DIR=./local/custom_nodes

# Optional Hugging Face token for gated model sets such as FLUX.2 Klein.
# Accept the model license first. The wrapper pipes this value only to the
# short-lived downloader; it is not added to Compose container environments.
# HF_TOKEN=hf_your_read_token

# Docker adds this supplementary group for shared/NAS model storage.
HOST_MODEL_GID=1000

# Network and GPU selection; `up` applies a change.
# 127.0.0.1 and [::1] need no acknowledgement; `localhost` is not a binding
# Docker Compose accepts.
COMFY_BIND_ADDRESS=127.0.0.1
COMFY_PORT=4207
GPU_DEVICE=nvidia.com/gpu=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

# Build settings; `build` applies a change.
# CUDA architectures the SageAttention and custom-node builds compile for.
COMFY_CUDA_ARCH_LIST=12.0
# Parallel compile jobs of the SageAttention build; each takes several GB.
SAGE_BUILD_JOBS=2

# Runtime behavior; `up` applies a change.
# Enable ComfyUI Manager, the extension that installs third-party nodes in the UI.
COMFY_ENABLE_MANAGER=true
# SageAttention mode: off = smaller image without SageAttention (default),
# available = Sage-capable image with workflow-level use,
# global = Sage-capable image and ComfyUI applies Sage globally.
# Set global only after representative workflows pass with global Sage.
LATENTCRATE_SAGE=off
# Strict mode: disable external API nodes and block frontend internet access.
# This also blocks Manager's Extensions UI, so it is off by default.
COMFY_DISABLE_API_NODES=false
# true stops embedding prompts and workflows in generated files.
COMFY_DISABLE_METADATA=false
# Extra whitespace-separated ComfyUI flags. Advanced use only.
COMFYUI_EXTRA_ARGS=
# Container shared-memory (/dev/shm) size.
COMFY_SHM_SIZE=8gb
# Size of the container's writable in-memory /tmp.
COMFY_TMPFS_SIZE=1g
# Maximum number of processes inside the container.
COMFY_PIDS_LIMIT=2048
# Time the engine waits for a clean shutdown before force-stopping.
STOP_GRACE_PERIOD=30s
# Compose restart policy. `no` avoids reserving the GPU after a reboot;
# use `unless-stopped` for automatic restart.
RESTART_POLICY=no
# Permission mask for files the container creates on the host mounts.
UMASK=0002

# Binding beyond loopback requires an explicit acknowledgement in the wrapper.
COMFY_ALLOW_REMOTE=false

# Optional overrides.
# CONTAINER_ENGINE=podman
COMPOSE_PROJECT_NAME=latentcrate
# Image repository (default latentcrate/comfy); the wrapper appends
# :<variant>-<COMFYUI_REF>.
# LATENTCRATE_IMAGE=latentcrate/comfy-mybranch
# Advanced: absolute container paths, colon-separated, that the model
# downloader may also write to through model symlinks; a path the model-set
# container does not mount as a directory is refused.
# MODEL_SET_EXTRA_WRITE_ROOTS=/storage/models-a:/storage/models-b

# Frontend mode. Leave unset for the release frontend pinned in pins.env.
# COMFY_FRONTEND_MODE=release
#
# Build a trusted public fork/PR. The wrapper resolves a branch, tag, or PR
# reference that can change to a commit before the container build.
# COMFY_FRONTEND_MODE=git
# FRONTEND_GIT_URL=https://github.com/your-name/ComfyUI_frontend.git
# FRONTEND_GIT_REF=your-branch-or-full-commit
#
# Serve an existing prebuilt frontend dist/ without rebuilding the image.
# COMFY_FRONTEND_MODE=dist
# COMFY_FRONTEND_DIST_DIR=/absolute/path/to/ComfyUI_frontend/dist
#
# Recommended for an uncommitted source checkout. LatentCrate builds it with the
# pinned containerized Node/pnpm toolchain.
# COMFY_FRONTEND_MODE=source
# COMFY_FRONTEND_SOURCE_DIR=/absolute/path/to/ComfyUI_frontend
