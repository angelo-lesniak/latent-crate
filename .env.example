# LatentCrate settings reference: every setting with its default. A line in
# .env overrides it; run `bash bin/latentcrate init` to create a private .env
# (mode 0600). A shell variable overrides .env for one command. Values are
# used literally; keep comments on their own line.

# Compose project: the prefix of the container and network names. Every
# command uses it; run `down` before changing it.
COMPOSE_PROJECT_NAME=latentcrate

# Host directories; a relative path is resolved from the checkout, which none
# of them may be or contain, and no two may overlap. `init` creates them, `up`
# mounts them, `doctor` checks their permissions.
# User settings, workflows, inputs, outputs, and the managed custom nodes
# (custom_nodes below it; mounted writable).
COMFY_DATA_DIR=./data/comfy
# The model library; mounted writable.
COMFY_MODELS_DIR=./data/models
# Downloads, package caches, Triton, and temporary files; mounted writable.
COMFY_CACHE_DIR=./data/cache
# Private or unregistered node source; mounted read-only.
COMFY_LOCAL_NODES_DIR=./local/custom_nodes

# Docker only: the supplementary group added to the container for shared or
# NAS model storage; unset, the calling user's group. `up` applies a change;
# `doctor` warns when the models directory's group differs.
# HOST_MODEL_GID=1000

# Hugging Face read token for gated model sets; docs/privacy.md says where
# each token goes.
# HF_TOKEN=hf_your_read_token

# Civitai API key for Civitai files the creator limits to signed-in
# accounts. It is a second credential on disk: it acts as your Civitai account.
# CIVITAI_TOKEN=your_civitai_api_key

# Network; `up` applies a change, `doctor` reports it.
# Host address of the published UI port: 127.0.0.1 and [::1] need no
# acknowledgement; localhost is not a binding Compose accepts; any other
# address needs COMFY_ALLOW_REMOTE=true.
COMFY_BIND_ADDRESS=127.0.0.1
# Host port of the UI, 1 to 65535.
COMFY_PORT=4207
# Acknowledgement that the UI binds beyond loopback (true only after adding
# authentication and TLS in front of it).
COMFY_ALLOW_REMOTE=false

# GPU; `up` applies a change, `doctor` checks it.
# The NVIDIA CDI device name; nvidia.com/gpu=0 selects the first GPU.
GPU_DEVICE=nvidia.com/gpu=all
# The NVIDIA runtime capabilities the container gets.
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

# Build; `build` applies a change.
# CUDA architectures the SageAttention and custom-node builds compile for;
# `doctor` compares the list with the GPUs it sees.
COMFY_CUDA_ARCH_LIST=12.0
# Parallel compile jobs of the SageAttention build; each takes several GB.
SAGE_BUILD_JOBS=2

# Image variant; `build` and `up` apply a change (it selects the image).
# SageAttention mode: off = image without SageAttention, available = Sage
# image with workflow-level use, global = Sage image and ComfyUI applies Sage
# globally. Set global only after representative workflows pass with available.
LATENTCRATE_SAGE=off

# Runtime; `up` applies a change.
# ComfyUI Manager, the extension that installs third-party nodes in the UI.
COMFY_ENABLE_MANAGER=true
# Strict mode: disable external API nodes and block frontend internet access.
# It also blocks Manager's Extensions UI.
COMFY_DISABLE_API_NODES=false
# true stops embedding prompts and workflows in generated files.
COMFY_DISABLE_METADATA=false
# Extra whitespace-separated ComfyUI flags.
COMFYUI_EXTRA_ARGS=
# Shared memory (/dev/shm) of the container.
COMFY_SHM_SIZE=8gb
# The container's in-memory /tmp.
COMFY_TMPFS_SIZE=1g
# Processes the container may run.
COMFY_PIDS_LIMIT=2048
# Time the engine waits for a clean shutdown before force-stopping.
STOP_GRACE_PERIOD=30s
# Compose restart policy: no avoids reserving the GPU after a reboot;
# unless-stopped restarts the service automatically.
RESTART_POLICY=no
# Permission mask for files the container creates on the host mounts.
UMASK=0002

# Container engine, docker or podman; unset, Podman is tried first. Every
# engine command uses it; `doctor` reports the selection.
# CONTAINER_ENGINE=podman

# Image repository the tag <repository>:<variant>-<COMFYUI_REF> is built on;
# `build` and `up` apply a change.
# LATENTCRATE_IMAGE=latentcrate/comfy

# Colon-separated absolute host directories that `models fetch` may also
# write into through symbolic links below the models directory; each must
# exist as a directory or the download refuses.
# MODEL_SET_EXTRA_WRITE_ROOTS=/storage/models-a:/storage/models-b

# Frontend mode, release | git | dist | source; `up` and `build` apply it.
# release serves the frontend pinned in pins.env.
# COMFY_FRONTEND_MODE=release
# git builds a public fork: FRONTEND_GIT_REF is a branch, tag, or commit,
# resolved to a commit before the build.
# COMFY_FRONTEND_MODE=git
# FRONTEND_GIT_URL=https://github.com/your-name/ComfyUI_frontend.git
# FRONTEND_GIT_REF=your-branch-or-full-commit
# dist serves a prebuilt frontend dist/ tree without rebuilding the image.
# COMFY_FRONTEND_MODE=dist
# COMFY_FRONTEND_DIST_DIR=/absolute/path/to/ComfyUI_frontend/dist
# source builds an uncommitted frontend checkout with the pinned Node and
# pnpm toolchain in a container.
# COMFY_FRONTEND_MODE=source
# COMFY_FRONTEND_SOURCE_DIR=/absolute/path/to/ComfyUI_frontend
